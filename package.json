{
  "name": "obsidian-exerciser-plugin",
  "version": "0.1.0",
  "description": "Create, manage, preview, and copy programming exercises in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run build && npm run lint && npm test"
  },
  "keywords": ["obsidian", "exercise", "course-material", "code-viewer"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/obsidian-material-plugins/obsidian-exerciser-plugin.git"
  },
  "dependencies": {
    "minimatch": "^10.1.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.1",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^2.1.9"
  }
}
